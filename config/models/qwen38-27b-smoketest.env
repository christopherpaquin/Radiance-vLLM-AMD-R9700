# PHASE 0 SMOKE TEST ONLY -- not a deployment profile. Not referenced by
# install.sh, not a cutover target. Deletes cleanly once Phase 0 is done.
#
# Purpose: confirm the vllm-radiance image can load Qwen3.8-27B's hybrid
# architecture AT ALL, and confirm whether R4D actually engages for its 16
# full-attention blocks, using the maintainer's own stated tuning target
# (Qwen/Qwen3.8-27B-FP8) -- highest odds of a clean load, per upstream's
# own DOCKERHUB.md ("Qwen3.8-27B-FP8 ... is what everything here is tuned
# around"). Tiny context on purpose: 30.89GB FP8 weights leave almost no
# VRAM headroom on a 32GB card, so this profile exists only to prove
# architecture/R4D compatibility, not to serve real traffic. See
# config/models/qwen38-27b.env's header comment for the full decision tree
# this smoke test resolves.
MODEL_ID=Qwen/Qwen3.8-27B-FP8
SERVED_MODEL_NAME=smoketest

# Deliberately tiny -- this profile is not for real use, just to get the
# model resident in VRAM and generating at all.
MAX_MODEL_LEN=4096

# Deliberately conservative -- FP8 weights alone are ~30.89GB; leave real
# margin for this first-ever attempt rather than target 0.968.
GPU_MEMORY_UTILIZATION=0.90

QUANTIZATION=
KV_CACHE_DTYPE=fp8
TOOL_CALL_PARSER=qwen3_xml
REASONING_PARSER=qwen3
SPEC_DECODE_ARGS=

EXTRA_VLLM_ARGS=--trust-remote-code --language-model-only
