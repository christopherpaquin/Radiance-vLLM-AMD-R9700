# Model profile: Qwen3-Coder-30B-A3B-Instruct (fallback/comparison profile)
#
# Ported from the abandoned Containerized-VLLM-AMD-R9700 deployment, where
# this exact profile was already proven working end-to-end (started,
# health-checked, benchmarked, driven through OpenCode with real tool
# calls). Kept here as a guaranteed-working fallback -- see plan §6.4.
#
# MoE model: 30B total parameters, ~3.3B active per token. Serving still
# requires ALL expert weights resident in VRAM.
#
# Weights already cached on this host at ~/.cache/huggingface/hub (from the
# abandoned deployment) -- migrate into HF_CACHE_DIR to avoid re-download
# (plan §13).
#
# MODEL_ID is a third-party AWQ quantization (not published by Qwen or
# AMD) -- accuracy/quality has not been independently verified.
MODEL_ID=stelterlab/Qwen3-Coder-30B-A3B-Instruct-AWQ
SERVED_MODEL_NAME=qwen3-coder-30b-a3b

MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.68

# Leave empty deliberately -- do NOT set to "awq". This checkpoint is
# packaged in the "compressed-tensors" config format, not legacy AWQ;
# forcing --quantization awq fails hard at startup on this exact
# checkpoint (verified live on this host during the abandoned deployment).
QUANTIZATION=

KV_CACHE_DTYPE=

# qwen3_xml chosen over vLLM's qwen3_coder parser: qwen3_coder has a
# reported bug producing runaway "!!!!" output on long inputs containing a
# tool call (verified live on this host). qwen3_xml is the more stable
# choice for Qwen3-Coder specifically.
TOOL_CALL_PARSER=qwen3_xml
REASONING_PARSER=

SPEC_DECODE_ARGS=

EXTRA_VLLM_ARGS=
