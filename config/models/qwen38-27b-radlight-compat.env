# Radlight "existing compatibility fallback" profile
# (plan-radlight-integration §"Context and concurrency profiles", option
# 3) -- matches the Radiance-baseline production context (131072, see
# config/models/qwen38-27b.env) so the two stacks are benchmark-comparable
# apples-to-apples at the same context length. Use this if both the exact-
# parity (262144) and balanced (196608) profiles fail validate-model.sh's
# VRAM safety floor.
MODEL_ID=amd/Qwen3.8-27B-Quark-AWQ-MXFP4
SERVED_MODEL_NAME=scar-coder

MAX_MODEL_LEN=131072

# Scaled proportionally from Radlight's own 262144-ctx pair (131072/262144
# * 10200547328 = 5,100,273,664) -- STARTING POINT ONLY, same caveat as
# qwen38-27b-radlight-balanced.env: re-measure real VRAM headroom via
# validate-model.sh before trusting this number. At this shorter context
# there is likely room to raise MAX_NUM_SEQS above 2 (try 4, matching the
# Radiance baseline's own max_num_seqs range) -- re-derive from the actual
# Mamba-cache-block budget reported at startup, do not guess it.
KV_CACHE_MEMORY_BYTES=5100273664

KV_CACHE_DTYPE=fp8
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=2560

RADLIGHT_COMPILATION_CONFIG={"cudagraph_capture_sizes":[1,2,4,8,16],"pass_config":{"fuse_norm_quant":true,"fuse_act_quant":true}}
SPEC_DECODE_ARGS=--speculative-config '{"method":"dflash","model":"/models/drafter","num_speculative_tokens":7,"draft_sample_method":"probabilistic","attention_backend":"TRITON_ATTN"}'
CHAT_TEMPLATE_ARGS=
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_xml
EXTRA_VLLM_ARGS=
