# Model profile: Qwen3.8-27B on the Radlight stack (compose.radlight.yaml)
#
# EXACT-PARITY candidate with Radlight's own run.sh (context 262144, KV
# 10,200,547,328 bytes, max_num_seqs 2, batched tokens 2560, DFlash2 on).
# This is the profile the sequential canary validates FIRST -- see
# docs/RADLIGHT-TUNABLES.md for the full tunable-by-tunable rationale and
# config/models/qwen38-27b-radlight-balanced.env /
# qwen38-27b-radlight-compat.env for the two fallback context/concurrency
# profiles (plan's "Balanced fallback" / "Existing compatibility fallback").
#
# Target model: amd/Qwen3.8-27B-Quark-AWQ-MXFP4 (Radlight's own tuning
# target, R9700-specific MXFP4/W4A8 kernels) -- NOT promoted purely on
# throughput; must pass every correctness/tool-call gate in
# scripts/validate-model.sh before scripts/deploy.sh --promote is allowed
# to move it to production port 8080. docs/MODELS.md's existing "Avoid"
# note on this exact quant_method (a past loader crash on an OLDER vLLM
# build/older checkpoint) does not automatically carry over to this pinned
# vLLM 0.27/ROCm 10 stack -- re-verified here, not assumed fixed.
#
# Pinned HF revision: see VERSIONS' RADLIGHT_TARGET_MODEL_REVISION. Weights
# live at RADLIGHT_TARGET_MODEL_DIR (.env), populated by
# scripts/sync-radlight-models.sh -- never a live "amd/..." repo id passed
# directly to vllm serve (HF_HUB_OFFLINE=1 in compose.radlight.yaml would
# refuse that anyway).
MODEL_ID=amd/Qwen3.8-27B-Quark-AWQ-MXFP4
SERVED_MODEL_NAME=scar-coder

# Full Radlight-parity target -- native context of this checkpoint.
MAX_MODEL_LEN=262144

# Radlight's own explicit KV allocation (bytes), not a
# --gpu-memory-utilization percentage -- the two are not combined (vLLM
# 0.27's explicit KV-bytes flag overrides/replaces the percentage-based
# budget; see docs/RADLIGHT-TUNABLES.md for the exact flag-name
# verification against this pinned image's `vllm serve --help`).
KV_CACHE_MEMORY_BYTES=10200547328

KV_CACHE_DTYPE=fp8

# Radlight's own concurrency/batch shape -- tuned for its KV budget at full
# 262144 context, not a throughput-maximizing default. Do not raise without
# re-deriving the KV/Mamba-cache budget first (see docs/RADLIGHT-TUNABLES.md
# and the sibling qwen38-27b.env's max_num_seqs cautionary note -- the same
# "concurrency vs. Mamba-cache-block budget" class of failure applies here).
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=2560

# Radlight's own compilation config, used verbatim for the parity profile
# (plan requirement: preserve exact patch/config parity on the first
# canary). Passed as a single already-JSON-quoted shell value.
RADLIGHT_COMPILATION_CONFIG={"cudagraph_capture_sizes":[1,2,4,8,16],"pass_config":{"fuse_norm_quant":true,"fuse_act_quant":true}}

# DFlash2 speculative decoding -- pinned local drafter (see VERSIONS'
# RADLIGHT_DRAFTER_MODEL_ID/REVISION), 7 speculative tokens, probabilistic
# draft sampling, TRITON_ATTN drafter attention backend, exactly as
# Radlight's own run.sh. To run the mandatory DFlash2 output-equivalence
# gate (same prompts, same deterministic sampling, with vs. without),
# redeploy with config/models/qwen38-27b-radlight-nospec.env instead of
# editing this value in place.
SPEC_DECODE_ARGS=--speculative-config {"method":"dflash","model":"/models/drafter","num_speculative_tokens":7,"draft_sample_method":"probabilistic","attention_backend":"TRITON_ATTN"}

# Chat template A/B switch (task requirement -- Radlight's template changes
# more than serialization, it injects terse-answer/reasoning-effort
# behavior). Empty here = use the checkpoint's OWN bundled
# tokenizer_config.json chat_template (the vendor default) for this
# profile. config/models/qwen38-27b-radlight-template.env is the same
# profile with CHAT_TEMPLATE_ARGS pointed at Radlight's pinned template
# instead -- run both through scripts/test-tool-calling.sh and compare
# before picking a production default (see docs/RADLIGHT-TUNABLES.md).
CHAT_TEMPLATE_ARGS=

REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_xml

EXTRA_VLLM_ARGS=
