# Same as qwen38-27b-radlight.env with DFlash2 speculative decoding turned
# OFF (SPEC_DECODE_ARGS empty) -- the clean switch required for the
# mandatory DFlash2 output-equivalence gate. Target model and every other
# setting stay identical so the with/without comparison isolates DFlash2
# specifically (plan-radlight-integration §"DFlash2 speculative decoding" /
# §"Correctness"): run the same prompts, same deterministic sampling
# config, against this profile and qwen38-27b-radlight.env, then compare
# final generated token IDs / normalized output. Any unexplained divergence
# blocks shipping DFlash2, per that gate's explicit requirement.
MODEL_ID=amd/Qwen3.8-27B-Quark-AWQ-MXFP4
SERVED_MODEL_NAME=scar-coder
MAX_MODEL_LEN=262144
KV_CACHE_MEMORY_BYTES=10200547328
KV_CACHE_DTYPE=fp8
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=2560
RADLIGHT_COMPILATION_CONFIG={"cudagraph_capture_sizes":[1,2,4,8,16],"pass_config":{"fuse_norm_quant":true,"fuse_act_quant":true}}
SPEC_DECODE_ARGS=
CHAT_TEMPLATE_ARGS=
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_xml
EXTRA_VLLM_ARGS=
