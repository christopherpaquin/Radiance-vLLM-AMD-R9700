# Radlight "balanced fallback" profile (docs/RADLIGHT-TUNABLES.md /
# plan-radlight-integration §"Context and concurrency profiles", option 2).
# Same model/quant/DFlash2/template choices as qwen38-27b-radlight.env --
# only MAX_MODEL_LEN and the KV byte budget differ. Use this if the
# exact-parity profile (262144 ctx) fails validate-model.sh's VRAM
# postflight safety floor (real headroom must stay >= ~0.75-1.0GiB under
# sustained generation, per rocm-smi/amd-smi, not vLLM's own estimate).
MODEL_ID=amd/Qwen3.8-27B-Quark-AWQ-MXFP4
SERVED_MODEL_NAME=scar-coder

MAX_MODEL_LEN=196608

# Scaled proportionally from Radlight's own 262144-ctx/10,200,547,328-byte
# pair (196608/262144 * 10200547328 ~= 7,650,410,496) as a STARTING POINT
# ONLY -- KV cache scales with context, but per-request activation/compile
# overhead does not, so this is not simply linear. Re-measure real VRAM
# headroom via validate-model.sh at this setting and adjust before trusting
# it; do not deploy this profile on the strength of the arithmetic alone.
KV_CACHE_MEMORY_BYTES=7650410496

KV_CACHE_DTYPE=fp8
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=2560

RADLIGHT_COMPILATION_CONFIG={"cudagraph_capture_sizes":[1,2,4,8,16],"pass_config":{"fuse_norm_quant":true,"fuse_act_quant":true}}
SPEC_DECODE_ARGS=--speculative-config '{"method":"dflash","model":"/models/drafter","num_speculative_tokens":7,"draft_sample_method":"probabilistic","attention_backend":"TRITON_ATTN"}'
CHAT_TEMPLATE_ARGS=
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_xml
EXTRA_VLLM_ARGS=
