# Same as qwen38-27b-radlight.env with Radlight's OWN pinned chat template
# (entrypoint/chat_template.jinja, vendored from
# huggingface.co/peculiar-ragdoll/Qwen-Sharp-Chat-Templates per Radlight's
# README) instead of the checkpoint's bundled vendor template. Radlight's
# template changes more than serialization -- it injects terse-answer and
# reasoning-effort behavior (task requirement: template choice must be
# A/B-tested, never defaulted to production without evidence). Compare
# scripts/test-tool-calling.sh and the correctness suite between this
# profile and qwen38-27b-radlight.env before picking a production default;
# document the result in docs/RADLIGHT-TUNABLES.md.
MODEL_ID=amd/Qwen3.8-27B-Quark-AWQ-MXFP4
SERVED_MODEL_NAME=scar-coder
MAX_MODEL_LEN=262144
KV_CACHE_MEMORY_BYTES=10200547328
KV_CACHE_DTYPE=fp8
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=2560
RADLIGHT_COMPILATION_CONFIG={"cudagraph_capture_sizes":[1,2,4,8,16],"pass_config":{"fuse_norm_quant":true,"fuse_act_quant":true}}
SPEC_DECODE_ARGS=--speculative-config {"method":"dflash","model":"/models/drafter","num_speculative_tokens":7,"draft_sample_method":"probabilistic","attention_backend":"TRITON_ATTN"}
CHAT_TEMPLATE_ARGS=--chat-template /opt/repo/entrypoint/chat_template.jinja
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_xml
EXTRA_VLLM_ARGS=
