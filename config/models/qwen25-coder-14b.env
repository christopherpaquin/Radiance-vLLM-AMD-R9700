# Model profile: Qwen2.5-Coder-14B-Instruct (fallback/comparison profile)
#
# Ported from the abandoned Containerized-VLLM-AMD-R9700 deployment, where
# this exact profile was already proven working end-to-end (started,
# health-checked, benchmarked, driven through OpenCode with real tool
# calls). Kept here as a guaranteed-working fallback if Qwen3.8-27B's
# hybrid architecture (plan §6.2) turns out unsupportable on the
# vllm-radiance image -- see plan §6.4.
#
# Weights already cached on this host at ~/.cache/huggingface/hub (from the
# abandoned deployment) -- migrate into HF_CACHE_DIR to avoid re-download
# (plan §13), or point HF_CACHE_DIR at that location instead for this
# profile specifically.
#
# Dense 14B (not MoE) -- memory footprint is exactly what it looks like.
# Officially published AWQ weights, not a third-party quantization.
MODEL_ID=Qwen/Qwen2.5-Coder-14B-Instruct-AWQ
SERVED_MODEL_NAME=qwen25-coder-14b

MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.72

# Force the ROCm-compatible AWQ kernel path explicitly -- avoids vLLM
# auto-selecting the CUDA-only "awq_marlin" path.
QUANTIZATION=awq

KV_CACHE_DTYPE=
TOOL_CALL_PARSER=hermes
REASONING_PARSER=

SPEC_DECODE_ARGS=

EXTRA_VLLM_ARGS=
