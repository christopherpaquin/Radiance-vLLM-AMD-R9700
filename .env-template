# Copy this file to .env and adjust as needed:
#   cp .env-template .env
#
# .env is gitignored -- real values (e.g. a Hugging Face token) never get
# committed. Model-specific settings (context length, GPU memory utilization,
# quantization, ...) live in config/models/*.env, not here. See docs/MODELS.md.
#
# See plan-radiance-vllm.md for the full design rationale behind every value
# below -- these comments summarize it, they don't replace it.

# ---------------------------------------------------------------------------
# Default model profile
# ---------------------------------------------------------------------------
DEFAULT_MODEL_PROFILE=qwen38-27b

# ---------------------------------------------------------------------------
# vLLM container image -- the Radiance stack (vllm-radiance / libr4d)
# ---------------------------------------------------------------------------
# Community project (StillDeadcode), NOT an AMD-official image. Chosen over
# the official rocm/vllm image per an explicit, risk-accepting decision --
# see plan-radiance-vllm.md §4.1. Pin to a digest, not a floating tag, once
# resolved (VERSIONS is the source of truth; verify-versions-pin.sh enforces
# this file and VERSIONS never drift apart).
#
# Resolved 2026-09-14: magiccodingman/vllm-radiance chosen over the
# canonical stilldeadcode/vllm-radiance -- stilldeadcode's latest tag
# (0.9.3) was ~3 weeks stale at resolution time; magiccodingman is an
# actively-maintained fork/superset (native gfx1201 MXFP4/W4A8, vLLM 0.28
# DFlash2, correctness backports), pushing every 1-4 days. Pinned to
# digest, not the floating tag, per this repo's pin convention.
VLLM_IMAGE=magiccodingman/vllm-radiance@sha256:83a9dc02a8f8e75aabe81366d36ebaa2e35fcbe181cacf8e8e0a4cef4ebccbcc

# Last-resort fallback image if vllm-radiance fails to run at all on this
# host (plan §4.1) -- not used unless that happens, kept here so the
# fallback is a one-line .env edit, not a rewrite.
VLLM_IMAGE_FALLBACK=rocm/vllm:rocm7.14.1_rdna_ubuntu24.04_py3.14_pytorch_2.11_vllm_0.23.0

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
# Staging default: 8081, so this can run alongside the still-live llamacpp
# container on 8080 during validation (plan §3.1). cutover.sh changes this
# to 8080 as the one step that takes over the production port.
API_PORT=8081
API_BIND_ADDRESS=0.0.0.0

# ---------------------------------------------------------------------------
# Storage -- dedicated system path, not ~/.cache/huggingface (plan §13:
# matches the llama.cpp deployment's /var/lib/llamacpp/ convention, fits the
# host's "dedicated inference server" role). Created by install.sh via sudo.
# ---------------------------------------------------------------------------
HF_CACHE_DIR=/var/lib/radiance-vllm/hf-cache
VLLM_CACHE_DIR=/var/lib/radiance-vllm/vllm-cache

# Optional: Hugging Face token, only needed for gated models.
HUGGING_FACE_HUB_TOKEN=

# ---------------------------------------------------------------------------
# Container behavior
# ---------------------------------------------------------------------------
CONTAINER_NAME=radiance-vllm
RESTART_POLICY=unless-stopped

# ---------------------------------------------------------------------------
# Host memory limit (cgroup) -- REQUIRED, not optional. The prior vLLM
# deployment on this exact host hit a real kernel-OOM lockup from
# unconstrained container host-RAM growth (weights staged on CPU,
# ROCm/PyTorch host buffers, ipc: host shm). MEM_LIMIT gives headroom above
# observed steady-state; MEM_RESERVATION is the soft target the kernel
# reclaims toward under pressure. Raise both if real measurement (see
# docs/TUNING.md once run) shows steady-state usage exceeds this.
# ---------------------------------------------------------------------------
MEM_LIMIT=32g
MEM_RESERVATION=26g

# ---------------------------------------------------------------------------
# GPU device group access
# ---------------------------------------------------------------------------
# Resolved automatically and numerically by scripts/deploy.sh via
# `getent group video render` -- override here only if that resolution
# fails on this host (see docs/ROCM.md).
# VIDEO_GID=44
# RENDER_GID=992

# ---------------------------------------------------------------------------
# gfx1201 / RDNA4 runtime environment
# ---------------------------------------------------------------------------
# NOTE (resolved 2026-09-14, corrects plan §5.1's generic list): this image
# bundles PYTORCH_ROCM_ARCH=gfx1201 as a BUILD-TIME Dockerfile ARG, already
# baked in -- it is NOT a runtime env var for this image and setting it here
# has no effect. The generic AITER/Triton/hipBLASLt vars below are kept as
# they're still applicable general ROCm/vLLM knobs, but none of them appear
# in vllm-radiance's own documented env-var surface (see RADIANCE_* below,
# which is the actual first-class configuration surface for this image).
VLLM_ROCM_USE_AITER=1
VLLM_ROCM_USE_AITER_RMSNORM=0
FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE
ROCBLAS_USE_HIPBLASLT=1
TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1
HIP_VISIBLE_DEVICES=0

# ---------------------------------------------------------------------------
# vllm-radiance / libr4d specific controls (resolved 2026-09-14 from
# upstream DOCKERHUB.md -- verbatim source, not guessed). R4D REFUSES
# (hard startup failure, not a silent fallback) if the model's attention
# shape doesn't match its constraints (head_dim 256, paged block 16, 6
# query heads per KV head, causal, bf16/fp8_e4m3 KV) -- plan §8.1's
# "fallback to standard attention" must be driven by explicitly setting
# RADIANCE_USE_R4D=0 (and RADIANCE_USE_R4D_GDN=0) after seeing that
# refusal in the logs, not assumed automatic.
# ---------------------------------------------------------------------------
# Master switch for R4D on the 16 full-attention (Gated Attention) blocks.
# Default 1 (on) -- upstream docs state this whole project is explicitly
# tuned around this model family's exact layer split (64 layers: 48
# linear-attention/GDN + 16 full-attention), so leave enabled for Phase 0.
RADIANCE_USE_R4D=1
# R4D for the 48 Gated-DeltaNet (linear attention) blocks specifically --
# a separate switch from the above. Default 1 (on).
RADIANCE_USE_R4D_GDN=1
# DFlash2 speculative-decoding tuning knobs -- defaults from upstream docs,
# not yet tuned for this deployment. Leave at documented defaults for
# Phase 0; revisit only if DFlash2 passes its correctness gate (plan §8.2).
# RADIANCE_DYNAMIC_DRAFT=
# RADIANCE_DRAFT_SCHEDULE=
# RADIANCE_DRAFT_TAU=
# MXFP4 native weight routing -- off by default. Only relevant if the
# Phase 0 bake-off ends up using a Quark/OCP MXFP4 checkpoint instead of
# the INT4 compressed-tensors candidate (see config/models/qwen38-27b.env
# for the full FP8-vs-MXFP4-vs-INT4 tradeoff this image's own tuning
# target forces us to resolve in Phase 0).
# RADIANCE_MXFP4=0
# RADIANCE_MXFP4_W4A8=0
