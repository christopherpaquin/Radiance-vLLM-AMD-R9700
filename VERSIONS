VLLM_IMAGE_TAG=1.0.16
VLLM_IMAGE_DIGEST=sha256:83a9dc02a8f8e75aabe81366d36ebaa2e35fcbe181cacf8e8e0a4cef4ebccbcc
VLLM_IMAGE_REF="${VLLM_IMAGE_REPO}@${VLLM_IMAGE_DIGEST}"

