# an official AMD image, already validated once on this host via the
# abandoned Containerized-VLLM-AMD-R9700 deployment.
VLLM_FALLBACK_IMAGE_REF=rocm/vllm:rocm7.14.1_rdna_ubuntu24.04_py3.14_pytorch_2.11_vllm_0.23.0

# --- Model checkpoints (see config/models/*.env for full rationale) --------
